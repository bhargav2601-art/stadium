# Local PostgreSQL. Never commit real values. Copy this file to .env.
DATABASE_URL="postgresql://USER@localhost:5432/anil_kumble"
TEST_DATABASE_URL="postgresql://USER@localhost:5432/anil_kumble_test"

# Required to create the first super administrator. Not read by the running app as a login bypass.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Local development sample accounts. Ignored when NODE_ENV=production.
SEED_DEMO_DATA="false"
SEED_DEMO_PASSWORD=""

# Signs sandbox payment callbacks on the server. Replace in every environment.
SANDBOX_PAYMENT_SECRET=""

# Razorpay. Leave blank to keep the sandbox payment workflow.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Optional Supabase (Postgres can be hosted there; Auth/Storage/Realtime are optional).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="avatars"

# Protects POST /api/cron/reminders
CRON_SECRET=""

# Public site URL used in absolute links. No trailing slash.
APP_URL="http://localhost:3000"
